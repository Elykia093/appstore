{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "gitIgnoredAuthors": ["githubaction@githubaction.com"],
  "rebaseWhen": "auto",
  "prCreation": "immediate",
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "enabledManagers": ["docker-compose"],
  "includePaths": ["apps/**/docker-compose.yml"],
  "packageRules": [
    {
      "description": "Track only 1Panel app Docker images and pin digests so floating latest tags produce update PRs.",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "apps/*/*/docker-compose.yml"
      ],
      "pinDigests": true,
      "versioning": "docker"
    },
    {
      "description": "Treat AxonHub prerelease tags as SemVer instead of Docker compatibility suffixes.",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["looplj/axonhub"],
      "versioning": "loose"
    },
    {
      "description": "Track New API prerelease tags while keeping the 1Panel image readable without an @sha256 digest.",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["calciumion/new-api"],
      "pinDigests": false,
      "versioning": "loose"
    }
  ]
}
